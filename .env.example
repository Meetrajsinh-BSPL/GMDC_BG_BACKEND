# OCI / Cohere
OCI_CONFIG_FILE=/root/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaakwwijvrkfgczblpkw4nrwgp35hsztnyoocre77gtbvznzctsogoa
OCI_GENAI_ENDPOINT=https://inference.generativeai.ap-hyderabad-1.oci.oraclecloud.com
OCI_MODEL_ID=ocid1.generativeaimodel.oc1.ap-hyderabad-1.amaaaaaask7dceyaaccktjkitpfn3zp3xnkg6yclc6izeahggh2hkwawfjna

# ICICI (ROTATE the API key before use — the old value has been leaked in git history)
ICICI_API_KEY=REPLACE_ME
ICICI_BASE_URL=https://igateway.icicibank.com
ICICI_ENDPOINT=/apibanking/live/corpapi/v2/eBG/fetchbg-issuance-amend
ICICI_CORP_ID=GUJARATM31122012
ICICI_TIMEOUT_S=30

# Path inside container to ICICI public certificate (PEM)
ICICI_CERT_PEM_PATH=/app/certs/icici.pem

# Flask
FLASK_ENV=production
MAX_CONTENT_LENGTH=33554432
# Comma-separated list of allowed origins, or '*' for any
CORS_ALLOWED_ORIGINS=*
# Optional shared-secret; if set, callers must include X-API-Key
API_KEY=
# Enable /test-encryption debug endpoint (dev only)
ENABLE_DEBUG_ENDPOINTS=false

# Cohere extraction tuning
COHERE_MAX_INPUT_CHARS=12000
